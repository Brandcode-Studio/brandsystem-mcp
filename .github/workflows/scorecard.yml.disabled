# OpenSSF Scorecard — DRAFT, NOT ACTIVE.
#
# GitHub only runs *.yml / *.yaml files in this directory, so this file does
# nothing until it is renamed. ossf/scorecard-action is a third-party action,
# and the repo's Actions policy allows only GitHub-owned actions. To opt in:
#
#   1. Settings → Actions → General → "Allow select actions and reusable
#      workflows" → add this exact pattern to the allowed list:
#
#        ossf/scorecard-action@fa7117db83c52d787ae5a89f350999701505d78e
#
#      (v2.5.0, released 2026-10-12. For a longer cooldown use v2.4.4,
#      2d1146689b8cda280b9bc96326124645441f03bc, and change the pin below.)
#      Note: the action is Docker-based and pulls
#      ghcr.io/ossf/scorecard-action:v2.5.0 at run time.
#   2. git mv .github/workflows/scorecard.yml.disabled .github/workflows/scorecard.yml
#   3. Do NOT make the job a required check — it runs on push to main and on a
#      schedule, not on pull requests.
#
# Everything else it uses (checkout, upload-artifact, codeql-action/upload-sarif)
# is GitHub-owned and pinned to the SHAs already used elsewhere in this repo.

name: Scorecard

on:
  branch_protection_rule:
  schedule:
    - cron: "17 6 * * 1"
  push:
    branches: [main]

permissions: {}

jobs:
  analysis:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read
      security-events: write # upload SARIF to code scanning
      id-token: write # sign results for publication to api.scorecard.dev (badge)
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: ossf/scorecard-action@fa7117db83c52d787ae5a89f350999701505d78e # v2.5.0
        with:
          results_file: results.sarif
          results_format: sarif
          publish_results: true
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: scorecard-sarif
          path: results.sarif
          retention-days: 5
      - uses: github/codeql-action/upload-sarif@9b3254085494b55a0f7c4c2b3d2d52cc712ce370 # v4.39.1
        with:
          sarif_file: results.sarif
